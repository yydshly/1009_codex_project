{
  "version": "R30 caption edition of retained R29 film",
  "movie": "../media/current-r29.mp4",
  "duration": 642.681867,
  "speechCount": 41,
  "narrations": 33,
  "dialogues": 8,
  "timingMethod": "Waveform-verified speech starts; internal phrase timings estimated from source pauses and character weight. Not word-level forced alignment.",
  "defaultTrack": "33 narration clips; all 8 selected character replies already have burned-in captions in R29.",
  "phrases": [
    {
      "id": "earth-arrival",
      "kind": "narration",
      "role": "导览",
      "start": 0.454,
      "end": 5.779,
      "text": "人怎样在这片土地上生活，并与外界联系？从地球找到新疆，"
    },
    {
      "id": "earth-arrival",
      "kind": "narration",
      "role": "导览",
      "start": 5.779,
      "end": 8.117,
      "text": "再沿水与道路走进去。"
    },
    {
      "id": "water-inland",
      "kind": "narration",
      "role": "导览",
      "start": 12.395,
      "end": 16.973,
      "text": "新疆位于大陆腹地。现在靠近这里，把山系与盆地展开。"
    },
    {
      "id": "region-structure",
      "kind": "narration",
      "role": "导览",
      "start": 26.065,
      "end": 32.905,
      "text": "阿尔泰山在北，天山居中，昆仑山在南。两大盆地位于山系之间。"
    },
    {
      "id": "region-structure",
      "kind": "narration",
      "role": "导览",
      "start": 32.905,
      "end": 35.275,
      "text": "先看整体，再找地点。"
    },
    {
      "id": "region-ice",
      "kind": "narration",
      "role": "导览",
      "start": 39.715,
      "end": 45.059,
      "text": "在天山找到乌鲁木齐一号冰川。先在区域图锁定位置，"
    },
    {
      "id": "region-ice",
      "kind": "narration",
      "role": "导览",
      "start": 45.059,
      "end": 46.76,
      "text": "再进入真实冰谷。"
    },
    {
      "id": "water-mountains",
      "kind": "narration",
      "role": "导览",
      "start": 60.001,
      "end": 65.811,
      "text": "从冰雪与沟谷追问用水，再转向吐鲁番。两处并非同一条实测水系。"
    },
    {
      "id": "oasis-engineering",
      "kind": "narration",
      "role": "导览",
      "start": 78.06,
      "end": 84.07,
      "text": "来到吐鲁番，先展开坎儿井。竖井连接施工与维护，"
    },
    {
      "id": "oasis-engineering",
      "kind": "narration",
      "role": "导览",
      "start": 84.07,
      "end": 90.35,
      "text": "暗渠利用坡降输水。水路接到地表，再安排送到哪里。"
    },
    {
      "id": "water-ice",
      "kind": "narration",
      "role": "导览",
      "start": 102.246,
      "end": 107.939,
      "text": "家里和田里，都在等第一道水。选择先送到家里，或先送到田里，"
    },
    {
      "id": "water-ice",
      "kind": "narration",
      "role": "导览",
      "start": 107.939,
      "end": 110.218,
      "text": "看工作的顺序怎样改变。"
    },
    {
      "id": "water-home",
      "kind": "dialogue",
      "role": "家人",
      "start": 112.921,
      "end": 116.391,
      "text": "水接到了。我们再帮田边打开支渠。"
    },
    {
      "id": "water-flow",
      "kind": "narration",
      "role": "导览",
      "start": 117.835,
      "end": 123.745,
      "text": "水抵达家门，也进入田垄。人的维护，让山水接上生活。"
    },
    {
      "id": "oasis-use",
      "kind": "narration",
      "role": "导览",
      "start": 139.286,
      "end": 143.25,
      "text": "水路连着田地、家庭和往来者。工程需要维护，"
    },
    {
      "id": "oasis-use",
      "kind": "narration",
      "role": "导览",
      "start": 143.25,
      "end": 145.767,
      "text": "生活也需要日复一日的协作。"
    },
    {
      "id": "water-valley",
      "kind": "narration",
      "role": "导览",
      "start": 162.79,
      "end": 166.775,
      "text": "两处都接上了水，生活还需要物品与补给。回到地图，"
    },
    {
      "id": "water-valley",
      "kind": "narration",
      "role": "导览",
      "start": 166.775,
      "end": 169.676,
      "text": "看看怎样接上外面的道路。"
    },
    {
      "id": "oasis-dry",
      "kind": "narration",
      "role": "导览",
      "start": 179.312,
      "end": 182.772,
      "text": "水路回答了怎样留下来。回到盆地边缘的绿洲，"
    },
    {
      "id": "oasis-dry",
      "kind": "narration",
      "role": "导览",
      "start": 182.772,
      "end": 185.482,
      "text": "现在追问怎样与外界联系。"
    },
    {
      "id": "oasis-wind",
      "kind": "narration",
      "role": "导览",
      "start": 191.348,
      "end": 198.833,
      "text": "沿盆地边缘向西。水、食物与补给，让远行能继续。下一处停留，"
    },
    {
      "id": "oasis-wind",
      "kind": "narration",
      "role": "导览",
      "start": 198.833,
      "end": 200.629,
      "text": "逐步靠近喀什。"
    },
    {
      "id": "oasis-nodes",
      "kind": "narration",
      "role": "导览",
      "start": 203.365,
      "end": 209.435,
      "text": "锁定喀什。把停留的问题带进集市：家人、远行者与手艺人，"
    },
    {
      "id": "oasis-nodes",
      "kind": "narration",
      "role": "导览",
      "start": 209.435,
      "end": 210.952,
      "text": "需要不同物品。"
    },
    {
      "id": "exchange-network",
      "kind": "narration",
      "role": "导览",
      "start": 216.164,
      "end": 220.374,
      "text": "丝路有不同时期、多条道路。山前的停留节点，"
    },
    {
      "id": "exchange-network",
      "kind": "narration",
      "role": "导览",
      "start": 220.374,
      "end": 223.563,
      "text": "承接货物、技艺与人的往来。"
    },
    {
      "id": "exchange-stops",
      "kind": "narration",
      "role": "导览",
      "start": 228.126,
      "end": 232.576,
      "text": "喀什位于盆地西缘。山前道路在这里交汇，"
    },
    {
      "id": "exchange-stops",
      "kind": "narration",
      "role": "导览",
      "start": 232.576,
      "end": 234.848,
      "text": "接下来走进一处绿洲集市。"
    },
    {
      "id": "exchange-goods",
      "kind": "narration",
      "role": "导览",
      "start": 249.945,
      "end": 256.082,
      "text": "家人等织物，远行者缺补给，手艺人等器物。先把哪一批货物，"
    },
    {
      "id": "exchange-goods",
      "kind": "narration",
      "role": "导览",
      "start": 256.082,
      "end": 258.134,
      "text": "送到需要的人手中？"
    },
    {
      "id": "market-cloth",
      "kind": "dialogue",
      "role": "家人",
      "start": 269.021,
      "end": 272.981,
      "text": "孩子披上了。这次停留，也留下了照应。"
    },
    {
      "id": "exchange-city",
      "kind": "narration",
      "role": "导览",
      "start": 275.951,
      "end": 280.871,
      "text": "物品留了下来，商旅还会继续走。可是，要长期留下的人，"
    },
    {
      "id": "exchange-city",
      "kind": "narration",
      "role": "导览",
      "start": 280.871,
      "end": 282.766,
      "text": "怎样重新安顿生活？"
    },
    {
      "id": "exchange-question",
      "kind": "narration",
      "role": "导览",
      "start": 292.494,
      "end": 298.192,
      "text": "先找到伊犁，再转入1764年的锡伯西迁。比较长期安顿，"
    },
    {
      "id": "exchange-question",
      "kind": "narration",
      "role": "导览",
      "start": 298.192,
      "end": 300.808,
      "text": "移动原因也变为国家调遣。"
    },
    {
      "id": "memory-departure",
      "kind": "narration",
      "role": "导览",
      "start": 311.955,
      "end": 318.111,
      "text": "1764年，清政府为加强伊犁防务，调遣锡伯官兵及家属西行。"
    },
    {
      "id": "memory-departure",
      "kind": "narration",
      "role": "导览",
      "start": 318.111,
      "end": 323.426,
      "text": "成年人收好文书，孩子守着行装；这一家人为创作角色，"
    },
    {
      "id": "memory-departure",
      "kind": "narration",
      "role": "导览",
      "start": 323.426,
      "end": 325.519,
      "text": "文书也不是档案复刻。"
    },
    {
      "id": "memory-journey",
      "kind": "narration",
      "role": "导览",
      "start": 330.664,
      "end": 336.464,
      "text": "把远行放回地球。从盛京一带向西，跨过高原，抵达伊犁。"
    },
    {
      "id": "memory-journey",
      "kind": "narration",
      "role": "导览",
      "start": 336.464,
      "end": 340.499,
      "text": "弧线表示西迁方向，并非考证的逐站道路。"
    },
    {
      "id": "memory-arrival",
      "kind": "narration",
      "role": "导览",
      "start": 355.374,
      "end": 360.25,
      "text": "抵达之后，先引水到田，还是先安顿家人？让工具或家书，"
    },
    {
      "id": "memory-arrival",
      "kind": "narration",
      "role": "导览",
      "start": 360.25,
      "end": 362.027,
      "text": "接上下一代的生活。"
    },
    {
      "id": "family-home",
      "kind": "dialogue",
      "role": "孩子",
      "start": 374.567,
      "end": 378.527,
      "text": "灯亮了，家书也接到了。坐下来，讲讲来时的路。"
    },
    {
      "id": "memory-muqam",
      "kind": "narration",
      "role": "导览",
      "start": 387.995,
      "end": 392.395,
      "text": "工具与家书，让我们看见经验和记忆的接续。"
    },
    {
      "id": "memory-muqam",
      "kind": "narration",
      "role": "导览",
      "start": 392.395,
      "end": 396.44,
      "text": "带着这个问题回到新疆，转向哈密的文化案例。"
    },
    {
      "id": "memory-muqam",
      "kind": "narration",
      "role": "导览",
      "start": 396.44,
      "end": 402.578,
      "text": "锡伯西迁与维吾尔木卡姆属于不同社区，比较的是下一代怎样参与。"
    },
    {
      "id": "memory-practice",
      "kind": "narration",
      "role": "导览",
      "start": 417.535,
      "end": 422.92,
      "text": "示范者放慢双手，留出停顿。再观察一次，还是现在参与？"
    },
    {
      "id": "memory-practice",
      "kind": "narration",
      "role": "导览",
      "start": 422.92,
      "end": 425.393,
      "text": "看你的回应怎样被接住。"
    },
    {
      "id": "culture-listen",
      "kind": "dialogue",
      "role": "学习者",
      "start": 433.683,
      "end": 437.443,
      "text": "我看清这一次停顿了。现在接上，再慢慢练。"
    },
    {
      "id": "modern-hubs",
      "kind": "narration",
      "role": "导览",
      "start": 448.094,
      "end": 453.563,
      "text": "庭院给下一位留出停顿。当生活、运输与维护同时需要空间，"
    },
    {
      "id": "modern-hubs",
      "kind": "narration",
      "role": "导览",
      "start": 453.563,
      "end": 455.258,
      "text": "怎样听见彼此？"
    },
    {
      "id": "modern-urumqi",
      "kind": "narration",
      "role": "导览",
      "start": 467.686,
      "end": 474.602,
      "text": "车辆、吊机与信息共同转运。货物继续走，还需要维护与安排。"
    },
    {
      "id": "modern-urumqi",
      "kind": "narration",
      "role": "导览",
      "start": 474.602,
      "end": 476.547,
      "text": "下一站，霍尔果斯。"
    },
    {
      "id": "modern-kashgar",
      "kind": "narration",
      "role": "导览",
      "start": 486.205,
      "end": 489.58,
      "text": "锁定霍尔果斯。从接水、交接与学习，"
    },
    {
      "id": "modern-kashgar",
      "kind": "narration",
      "role": "导览",
      "start": 489.58,
      "end": 492.506,
      "text": "走向同一片空间里的多种需要。"
    },
    {
      "id": "modern-rules",
      "kind": "narration",
      "role": "导览",
      "start": 505.625,
      "end": 508.76,
      "text": "关口里的协作，也要听见不同需求。"
    },
    {
      "id": "modern-rules",
      "kind": "narration",
      "role": "导览",
      "start": 508.76,
      "end": 514.616,
      "text": "居民、运输工和生境维护者围桌交流，讨论生活、交接与保护。"
    },
    {
      "id": "civic-resident",
      "kind": "dialogue",
      "role": "附近居民",
      "start": 515.637,
      "end": 518.757,
      "text": "货物要走，我们也需要安静、安全的日常。"
    },
    {
      "id": "civic-worker",
      "kind": "dialogue",
      "role": "货运工作人员",
      "start": 520.677,
      "end": 524.067,
      "text": "车队还在等。能否集中交接，少跑几趟？"
    },
    {
      "id": "civic-steward",
      "kind": "dialogue",
      "role": "生境维护者",
      "start": 525.764,
      "end": 529.164,
      "text": "留下连续的绿带，也要留出维护的空间。"
    },
    {
      "id": "modern-limit",
      "kind": "narration",
      "role": "导览",
      "start": 531.724,
      "end": 538.039,
      "text": "三种需要，已经听见。轮换通行，集中交接，还是保留绿带？"
    },
    {
      "id": "modern-limit",
      "kind": "narration",
      "role": "导览",
      "start": 538.039,
      "end": 540.71,
      "text": "看安排怎样回应人们。"
    },
    {
      "id": "civic-balanced",
      "kind": "dialogue",
      "role": "协作回应",
      "start": 547.695,
      "end": 552.765,
      "text": "先轮换通行，留出缓冲。等待和维护，都继续记录。"
    },
    {
      "id": "future-landscape",
      "kind": "narration",
      "role": "导览",
      "start": 559.656,
      "end": 564.685,
      "text": "先留在关口。沿标记看谁得到了回应，谁还需要下一步安排。"
    },
    {
      "id": "future-budget",
      "kind": "narration",
      "role": "导览",
      "start": 569.675,
      "end": 575.052,
      "text": "保留刚才的选择。通行与维护都需要承担，留下的缺口，"
    },
    {
      "id": "future-budget",
      "kind": "narration",
      "role": "导览",
      "start": 575.052,
      "end": 577.253,
      "text": "是下一次协商的起点。"
    },
    {
      "id": "future-evidence",
      "kind": "narration",
      "role": "导览",
      "start": 584.355,
      "end": 587.227,
      "text": "回看各处留下的回应。案例各自独立，"
    },
    {
      "id": "future-evidence",
      "kind": "narration",
      "role": "导览",
      "start": 587.227,
      "end": 589.681,
      "text": "接续的是我们关于生活的问题。"
    },
    {
      "id": "future-synthesis",
      "kind": "narration",
      "role": "导览",
      "start": 598.315,
      "end": 605.31,
      "text": "把实际观察放回新疆。水与维护支撑停留，道路让物品和人相遇；"
    },
    {
      "id": "future-synthesis",
      "kind": "narration",
      "role": "导览",
      "start": 605.31,
      "end": 611.29,
      "text": "历史影响家庭，文化由社区接续，公共安排回应共同的空间需要。"
    },
    {
      "id": "future-synthesis",
      "kind": "narration",
      "role": "导览",
      "start": 611.29,
      "end": 615.289,
      "text": "每一处都留下变化，也留下下一步问题。"
    },
    {
      "id": "future-result",
      "kind": "narration",
      "role": "导览",
      "start": 622.694,
      "end": 629.375,
      "text": "生活与联系，需要自然条件，也需要持续回应。带着观察回到整体，"
    },
    {
      "id": "future-result",
      "kind": "narration",
      "role": "导览",
      "start": 629.375,
      "end": 631.695,
      "text": "再选另一处继续探索。"
    }
  ],
