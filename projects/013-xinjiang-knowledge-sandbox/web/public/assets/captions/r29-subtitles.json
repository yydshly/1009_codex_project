      "start": 117.825,
      "end": 123.874,
      "text": "水抵达家门，也进入田垄。人的维护，让山水接上生活。"
    },
    {
      "id": "oasis-use",
      "kind": "narration",
      "role": "导览",
      "start": 139.286,
      "end": 145.767,
      "text": "水路连着田地、家庭和往来者。工程需要维护，生活也需要日复一日的协作。"
    },
    {
      "id": "water-valley",
      "kind": "narration",
      "role": "导览",
      "start": 162.726,
      "end": 169.676,
      "text": "两处都接上了水，生活还需要物品与补给。回到地图，看看怎样接上外面的道路。"
    },
    {
      "id": "oasis-dry",
      "kind": "narration",
      "role": "导览",
      "start": 179.305,
      "end": 185.562,
      "text": "水路回答了怎样留下来。回到盆地边缘的绿洲，现在追问怎样与外界联系。"
    },
    {
      "id": "oasis-wind",
      "kind": "narration",
      "role": "导览",
      "start": 191.326,
      "end": 200.629,
      "text": "沿盆地边缘向西。水、食物与补给，让远行能继续。下一处停留，逐步靠近喀什。"
    },
    {
      "id": "oasis-nodes",
      "kind": "narration",
      "role": "导览",
      "start": 203.334,
      "end": 210.952,
      "text": "锁定喀什。把停留的问题带进集市：家人、远行者与手艺人，需要不同物品。"
    },
    {
      "id": "exchange-network",
      "kind": "narration",
      "role": "导览",
      "start": 216.145,
      "end": 223.563,
      "text": "丝路有不同时期、多条道路。山前的停留节点，承接货物、技艺与人的往来。"
    },
    {
      "id": "exchange-stops",
      "kind": "narration",
      "role": "导览",
      "start": 228.126,
      "end": 234.848,
      "text": "喀什位于盆地西缘。山前道路在这里交汇，接下来走进一处绿洲集市。"
    },
    {
      "id": "exchange-goods",
      "kind": "narration",
      "role": "导览",
      "start": 249.945,
      "end": 258.134,
      "text": "家人等织物，远行者缺补给，手艺人等器物。先把哪一批货物，送到需要的人手中？"
    },
    {
      "id": "market-cloth",
      "kind": "dialogue",
      "role": "家人",
      "start": 268.915,
      "end": 273.056,
      "text": "孩子披上了。这次停留，也留下了照应。"
    },
    {
      "id": "exchange-city",
      "kind": "narration",
      "role": "导览",
      "start": 275.886,
      "end": 282.766,
      "text": "物品留了下来，商旅还会继续走。可是，要长期留下的人，怎样重新安顿生活？"
    },
    {
      "id": "exchange-question",
      "kind": "narration",
      "role": "导览",
      "start": 292.494,
      "end": 300.809,
      "text": "先找到伊犁，再转入1764年的锡伯西迁。比较长期安顿，移动原因也变为国家调遣。"
    },
    {
      "id": "memory-departure",
      "kind": "narration",
      "role": "导览",
      "start": 311.955,
      "end": 325.519,
      "text": "1764年，清政府为加强伊犁防务，调遣锡伯官兵及家属西行。成年人收好文书，孩子守着行装；这一家人为创作角色，文书也不是档案复刻。"
    },
    {
      "id": "memory-journey",
      "kind": "narration",
      "role": "导览",
      "start": 330.654,
      "end": 340.499,
      "text": "把远行放回地球。从盛京一带向西，跨过高原，抵达伊犁。弧线表示西迁方向，并非考证的逐站道路。"
    },
    {
      "id": "memory-arrival",
      "kind": "narration",
      "role": "导览",
      "start": 355.374,
      "end": 362.027,
      "text": "抵达之后，先引水到田，还是先安顿家人？让工具或家书，接上下一代的生活。"
    },
    {
      "id": "family-home",
      "kind": "dialogue",
      "role": "孩子",
      "start": 374.395,
      "end": 378.613,
      "text": "灯亮了，家书也接到了。坐下来，讲讲来时的路。"
    },
    {
      "id": "memory-muqam",
      "kind": "narration",
      "role": "导览",
      "start": 387.995,
      "end": 402.578,
      "text": "工具与家书，让我们看见经验和记忆的接续。带着这个问题回到新疆，转向哈密的文化案例。锡伯西迁与维吾尔木卡姆属于不同社区，比较的是下一代怎样参与。"
    },
    {
      "id": "memory-practice",
      "kind": "narration",
      "role": "导览",
      "start": 417.486,
      "end": 425.393,
      "text": "示范者放慢双手，留出停顿。再观察一次，还是现在参与？看你的回应怎样被接住。"
    },
    {
      "id": "culture-listen",
      "kind": "dialogue",
      "role": "学习者",
      "start": 433.515,
      "end": 437.52,
      "text": "我看清这一次停顿了。现在接上，再慢慢练。"
    },
    {
      "id": "modern-hubs",
      "kind": "narration",
      "role": "导览",
      "start": 448.094,
      "end": 455.258,
      "text": "庭院给下一位留出停顿。当生活、运输与维护同时需要空间，怎样听见彼此？"
    },
    {
      "id": "modern-urumqi",
      "kind": "narration",
      "role": "导览",
      "start": 467.686,
      "end": 476.548,
      "text": "车辆、吊机与信息共同转运。货物继续走，还需要维护与安排。下一站，霍尔果斯。"
    },
    {
      "id": "modern-kashgar",
      "kind": "narration",
      "role": "导览",
      "start": 486.174,
      "end": 492.506,
      "text": "锁定霍尔果斯。从接水、交接与学习，走向同一片空间里的多种需要。"
    },
    {
      "id": "modern-rules",
      "kind": "narration",
      "role": "导览",
      "start": 505.625,
      "end": 514.662,
      "text": "关口里的协作，也要听见不同需求。居民、运输工和生境维护者围桌交流，讨论生活、交接与保护。"
    },
    {
      "id": "civic-resident",
      "kind": "dialogue",
      "role": "附近居民",
      "start": 515.574,
      "end": 518.853,
      "text": "货物要走，我们也需要安静、安全的日常。"
    },
    {
      "id": "civic-worker",
      "kind": "dialogue",
      "role": "货运工作人员",
      "start": 520.574,
      "end": 524.178,
      "text": "车队还在等。能否集中交接，少跑几趟？"
    },
    {
      "id": "civic-steward",
      "kind": "dialogue",
      "role": "生境维护者",
      "start": 525.566,
      "end": 529.302,
      "text": "留下连续的绿带，也要留出维护的空间。"
    },
    {
      "id": "modern-limit",
      "kind": "narration",
      "role": "导览",
      "start": 531.665,
      "end": 540.71,
      "text": "三种需要，已经听见。轮换通行，集中交接，还是保留绿带？看安排怎样回应人们。"
    },
    {
      "id": "civic-balanced",
      "kind": "dialogue",
      "role": "协作回应",
      "start": 547.635,
      "end": 552.825,
      "text": "先轮换通行，留出缓冲。等待和维护，都继续记录。"
    },
    {
      "id": "future-landscape",
      "kind": "narration",
      "role": "导览",
      "start": 559.654,
      "end": 564.685,
      "text": "先留在关口。沿标记看谁得到了回应，谁还需要下一步安排。"
    },
    {
      "id": "future-budget",
      "kind": "narration",
      "role": "导览",
      "start": 569.675,
      "end": 577.253,
      "text": "保留刚才的选择。通行与维护都需要承担，留下的缺口，是下一次协商的起点。"
    },
    {
      "id": "future-evidence",
      "kind": "narration",
      "role": "导览",
      "start": 584.355,
      "end": 589.681,
      "text": "回看各处留下的回应。案例各自独立，接续的是我们关于生活的问题。"
    },
    {
      "id": "future-synthesis",
      "kind": "narration",
      "role": "导览",
      "start": 598.315,
      "end": 615.289,
      "text": "把实际观察放回新疆。水与维护支撑停留，道路让物品和人相遇；历史影响家庭，文化由社区接续，公共安排回应共同的空间需要。每一处都留下变化，也留下下一步问题。"
    },
    {
      "id": "future-result",
      "kind": "narration",
      "role": "导览",
      "start": 622.694,
      "end": 631.695,
      "text": "生活与联系，需要自然条件，也需要持续回应。带着观察回到整体，再选另一处继续探索。"
    }
  ]
}
