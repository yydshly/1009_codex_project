{
  "earth-arrival": [
    {
      "start": 0,
      "end": 5.325,
      "text": "人怎样在这片土地上生活，并与外界联系？从地球找到新疆，"
    },
    {
      "start": 5.325,
      "end": 7.663,
      "text": "再沿水与道路走进去。"
    }
  ],
  "water-inland": [
    {
      "start": 0,
      "end": 4.586,
      "text": "新疆位于大陆腹地。现在靠近这里，把山系与盆地展开。"
    }
  ],
  "region-structure": [
    {
      "start": 0.04,
      "end": 6.88,
      "text": "阿尔泰山在北，天山居中，昆仑山在南。两大盆地位于山系之间。"
    },
    {
      "start": 6.88,
      "end": 9.25,
      "text": "先看整体，再找地点。"
    }
  ],
  "region-ice": [
    {
      "start": 0,
      "end": 5.346,
      "text": "在天山找到乌鲁木齐一号冰川。先在区域图锁定位置，"
    },
    {
      "start": 5.346,
      "end": 7.047,
      "text": "再进入真实冰谷。"
    }
  ],
  "water-mountains": [
    {
      "start": 0.05,
      "end": 5.86,
      "text": "从冰雪与沟谷追问用水，再转向吐鲁番。两处并非同一条实测水系。"
    }
  ],
  "oasis-engineering": [
    {
      "start": 0.05,
      "end": 6.06,
      "text": "来到吐鲁番，先展开坎儿井。竖井连接施工与维护，"
    },
    {
      "start": 6.06,
      "end": 12.34,
      "text": "暗渠利用坡降输水。水路接到地表，再安排送到哪里。"
    }
  ],
  "water-ice": [
    {
      "start": 0,
      "end": 5.697,
      "text": "家里和田里，都在等第一道水。选择先送到家里，或先送到田里，"
    },
    {
      "start": 5.697,
      "end": 7.976,
      "text": "看工作的顺序怎样改变。"
    }
  ],
  "water-flow": [
    {
      "start": 0.01,
      "end": 5.92,
      "text": "水抵达家门，也进入田垄。人的维护，让山水接上生活。"
    }
  ],
  "oasis-use": [
    {
      "start": 0,
      "end": 3.985,
      "text": "水路连着田地、家庭和往来者。工程需要维护，"
    },
    {
      "start": 3.985,
      "end": 6.502,
      "text": "生活也需要日复一日的协作。"
    }
  ],
  "water-valley": [
    {
      "start": 0.08,
      "end": 4.065,
      "text": "两处都接上了水，生活还需要物品与补给。回到地图，"
    },
    {
      "start": 4.065,
      "end": 6.966,
      "text": "看看怎样接上外面的道路。"
    }
  ],
  "oasis-dry": [
    {
      "start": 0.02,
      "end": 3.48,
      "text": "水路回答了怎样留下来。回到盆地边缘的绿洲，"
    },
    {
      "start": 3.48,
      "end": 6.19,
      "text": "现在追问怎样与外界联系。"
    }
  ],
  "oasis-wind": [
    {
      "start": 0.03,
      "end": 7.515,
      "text": "沿盆地边缘向西。水、食物与补给，让远行能继续。下一处停留，"
    },
    {
      "start": 7.515,
      "end": 9.311,
      "text": "逐步靠近喀什。"
    }
  ],
  "exchange-network": [
    {
      "start": 0.02,
      "end": 4.23,
      "text": "丝路有不同时期、多条道路。山前的停留节点，"
    },
    {
      "start": 4.23,
      "end": 7.419,
      "text": "承接货物、技艺与人的往来。"
    }
  ],
  "oasis-nodes": [
    {
      "start": 0.04,
      "end": 6.11,
      "text": "锁定喀什。把停留的问题带进集市：家人、远行者与手艺人，"
    },
    {
      "start": 6.11,
      "end": 7.628,
      "text": "需要不同物品。"
    }
  ],
  "exchange-stops": [
    {
      "start": 0,
      "end": 4.45,
      "text": "喀什位于盆地西缘。山前道路在这里交汇，"
    },
    {
      "start": 4.45,
      "end": 6.722,
      "text": "接下来走进一处绿洲集市。"
    }
  ],
  "exchange-goods": [
    {
      "start": 0,
      "end": 6.157,
      "text": "家人等织物，远行者缺补给，手艺人等器物。先把哪一批货物，"
    },
    {
      "start": 6.157,
      "end": 8.21,
      "text": "送到需要的人手中？"
    }
  ],
  "exchange-city": [
    {
      "start": 0.07,
      "end": 4.99,
      "text": "物品留了下来，商旅还会继续走。可是，要长期留下的人，"
    },
    {
      "start": 4.99,
      "end": 6.885,
      "text": "怎样重新安顿生活？"
    }
  ],
  "exchange-question": [
    {
      "start": 0,
      "end": 5.708,
      "text": "先找到伊犁，再转入1764年的锡伯西迁。比较长期安顿，"
    },
    {
      "start": 5.708,
      "end": 8.324,
      "text": "移动原因也变为国家调遣。"
    }
  ],
  "memory-departure": [
    {
      "start": 0,
      "end": 6.165,
      "text": "1764年，清政府为加强伊犁防务，调遣锡伯官兵及家属西行。"
    },
    {
      "start": 6.165,
      "end": 11.48,
      "text": "成年人收好文书，孩子守着行装；这一家人为创作角色，"
    },
    {
      "start": 11.48,
      "end": 13.573,
      "text": "文书也不是档案复刻。"
    }
  ],
  "memory-journey": [
    {
      "start": 0.01,
      "end": 5.81,
      "text": "把远行放回地球。从盛京一带向西，跨过高原，抵达伊犁。"
    },
    {
      "start": 5.81,
      "end": 9.845,
      "text": "弧线表示西迁方向，并非考证的逐站道路。"
    }
  ],
  "memory-arrival": [
    {
      "start": 0,
      "end": 4.887,
      "text": "抵达之后，先引水到田，还是先安顿家人？让工具或家书，"
    },
    {
      "start": 4.887,
      "end": 6.664,
      "text": "接上下一代的生活。"
    }
  ],
  "memory-muqam": [
    {
      "start": 0,
      "end": 4.41,
      "text": "工具与家书，让我们看见经验和记忆的接续。"
    },
    {
      "start": 4.41,
      "end": 8.455,
      "text": "带着这个问题回到新疆，转向哈密的文化案例。"
    },
    {
      "start": 8.455,
      "end": 14.594,
      "text": "锡伯西迁与维吾尔木卡姆属于不同社区，比较的是下一代怎样参与。"
    }
  ],
  "memory-practice": [
    {
      "start": 0.06,
      "end": 5.445,
      "text": "示范者放慢双手，留出停顿。再观察一次，还是现在参与？"
    },
    {
      "start": 5.445,
      "end": 7.918,
      "text": "看你的回应怎样被接住。"
    }
  ],
  "modern-hubs": [
    {
      "start": 0,
      "end": 5.48,
      "text": "庭院给下一位留出停顿。当生活、运输与维护同时需要空间，"
    },
    {
      "start": 5.48,
      "end": 7.175,
      "text": "怎样听见彼此？"
    }
  ],
  "modern-urumqi": [
    {
      "start": 0,
      "end": 6.948,
      "text": "车辆、吊机与信息共同转运。货物继续走，还需要维护与安排。"
    },
    {
      "start": 6.948,
      "end": 8.893,
      "text": "下一站，霍尔果斯。"
    }
  ],
  "modern-kashgar": [
    {
      "start": 0.05,
      "end": 3.425,
      "text": "锁定霍尔果斯。从接水、交接与学习，"
    },
    {
      "start": 3.425,
      "end": 6.351,
      "text": "走向同一片空间里的多种需要。"
    }
  ],
  "modern-rules": [
    {
      "start": 0,
      "end": 3.154,
      "text": "关口里的协作，也要听见不同需求。"
    },
    {
      "start": 3.154,
      "end": 9.01,
      "text": "居民、运输工和生境维护者围桌交流，讨论生活、交接与保护。"
    }
  ],
  "modern-limit": [
    {
      "start": 0.07,
      "end": 6.385,
      "text": "三种需要，已经听见。轮换通行，集中交接，还是保留绿带？"
    },
    {
      "start": 6.385,
      "end": 9.056,
      "text": "看安排怎样回应人们。"
    }
  ],
  "future-landscape": [
    {
      "start": 0.01,
      "end": 5.039,
      "text": "先留在关口。沿标记看谁得到了回应，谁还需要下一步安排。"
    }
  ],
  "future-budget": [
    {
      "start": 0,
      "end": 5.38,
      "text": "保留刚才的选择。通行与维护都需要承担，留下的缺口，"
    },
    {
      "start": 5.38,
      "end": 7.581,
      "text": "是下一次协商的起点。"
    }
  ],
  "future-evidence": [
    {
      "start": 0,
      "end": 2.875,
      "text": "回看各处留下的回应。案例各自独立，"
    },
    {
      "start": 2.875,
      "end": 5.33,
      "text": "接续的是我们关于生活的问题。"
    }
  ],
  "future-synthesis": [
    {
      "start": 0,
      "end": 7.015,
      "text": "把实际观察放回新疆。水与维护支撑停留，道路让物品和人相遇；"
    },
    {
      "start": 7.015,
      "end": 12.995,
      "text": "历史影响家庭，文化由社区接续，公共安排回应共同的空间需要。"
    },
    {
      "start": 12.995,
      "end": 16.994,
      "text": "每一处都留下变化，也留下下一步问题。"
    }
  ],
  "future-result": [
    {
      "start": 0,
      "end": 6.701,
      "text": "生活与联系，需要自然条件，也需要持续回应。带着观察回到整体，"
    },
    {
      "start": 6.701,
      "end": 9.021,
      "text": "再选另一处继续探索。"
    }
  ]
}
